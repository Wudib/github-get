# ============================================================
# GitHub 热门项目雷达 - 环境变量配置
# 使用方式：cp .env.example .env 然后按需修改，最后 docker compose up -d
# ============================================================

# ---- 访问入口 ----
# 宿主机端口，浏览器访问 http://<服务器IP>:8080
HOST_PORT=8080
TZ=Asia/Shanghai
IMAGE_NAME=github-radar:1.0.0

# ---- GitHub 凭据（强烈建议配置）----
# 未认证：60 次/小时；认证后：5000 次/小时，且可批量刷新所有仓库的实时 Star
# 生成地址：https://github.com/settings/tokens （勾选 public_repo 即可，只读公库无需任何权限）
GITHUB_TOKEN=

# 如果公司内网通过代理访问外网，取消下面两行注释并填写代理地址
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1,10.0.0.0/8,192.168.0.0/16

# 如需走公司内部 GitHub 镜像/加速地址，按需修改
GITHUB_API_BASE=https://api.github.com
GITHUB_GRAPHQL_URL=https://api.github.com/graphql
GITHUB_TRENDING_BASE=https://github.com/trending
GITHUB_TIMEOUT_SECONDS=30

# ---- 采集策略 ----
# 采集间隔（分钟），建议 60；无 Token 时建议 180 以上
COLLECT_INTERVAL_MINUTES=60
# 周热门榜周期，可多选逗号分隔：daily,weekly,monthly
TRENDING_PERIODS=weekly
# 额外抓取指定语言的 Trending 榜（GitHub 语言 slug），例如：python,go,javascript
TRENDING_LANGUAGES=
# 新项目发现窗口（天），逗号分隔；数字越大覆盖越广但更耗配额
DISCOVERY_WINDOWS=7,30,90
# 新项目发现的最低 Star 门槛
DISCOVERY_MIN_STARS=100
# 每个窗口搜索的页数（每页 100 条）
DISCOVERY_PAGES=2
# 每轮补齐多少个仓库的详情（创建时间/许可证/主页/Topics）
# Trending 页面不提供这些字段，需要额外请求补全；配置 Token 后 GraphQL 会自动补齐，可设为 0
ENRICH_LIMIT=25
# 每小时做 Star 快照的仓库数量上限（越大 Star 增长曲线越完整）
MAX_TRACKED_REPOS=3000

# ---- 数据保留 ----
# 快照总保留天数
RETENTION_DAYS=90
# 该天数内保留每小时快照，更早的自动降采样为每天一条
HOURLY_KEEP_DAYS=14
# 多久没再出现的仓库会被清理
STALE_REPO_DAYS=180

# ---- 启动行为 ----
# 启动时是否运行定时调度器
RUN_ON_STARTUP=true
# 数据库为空时是否自动跑一次采集（首次部署后无需手动点）
COLLECT_ON_EMPTY_DB=true
LOG_LEVEL=INFO

# ============================================================
# ---- 中文翻译（可选，默认关闭）----
# 打开后，项目描述与标签会在采集时自动翻译成中文；关着就显示 GitHub 英文原文。
# 接口是 OpenAI 兼容格式，DeepSeek / 通义 / 智谱 / 公司内网大模型网关都能直接用。
# 成本参考：450 条描述一次性回填约 3 万 token（约 0.1~0.3 元），
#          之后每小时只翻新增仓库，每月大约几元到几十元。
# 说明：同一段描述只翻一次（按内容哈希缓存），标签全站去重后只翻一次。
# ============================================================
# 关闭填 off；启用填 openai
TRANSLATE_PROVIDER=off
# 接口地址（写到 /v1 即可，程序会自动补 /chat/completions）
#   DeepSeek： https://api.deepseek.com/v1
#   通义千问： https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM： https://open.bigmodel.cn/api/paas/v4
#   内网网关： http://your-gateway.intranet/v1
TRANSLATE_BASE_URL=
TRANSLATE_API_KEY=
# 模型名，例如 deepseek-chat / qwen-plus / glm-4-flash
TRANSLATE_MODEL=
# 一次请求打包多少条（越大越省 token，但单次响应更慢）
TRANSLATE_BATCH=20
# 每轮采集最多翻译多少条描述 / 多少个标签（控制单轮耗时）
TRANSLATE_PER_RUN=200
TRANSLATE_TOPICS_PER_RUN=200
# 超过多少字符的描述会被截断后再翻译
TRANSLATE_MAX_CHARS=300
# 单次翻译请求超时（秒）。网关慢就调大，或把 TRANSLATE_BATCH 调小
TRANSLATE_TIMEOUT=90
# 单轮翻译的时间上限（秒）：到点就停，剩余留到下一轮。
# 翻译独立于采集运行，所以超时/失败都不会拖慢采集，也不影响页面显示。
TRANSLATE_MAX_SECONDS=300

# ---- 网关太慢怎么调 ----
# 先看日志里的翻译耗时：出现「翻译网关较慢：20 条用了 160 秒（约 8.0 秒/条）」时
#   方案一：把 TRANSLATE_BATCH 调小（如 5），配合 TRANSLATE_TIMEOUT=60
#   方案二：保持批量，把 TRANSLATE_TIMEOUT 调大到 180
# 慢网关下整批超时会被自动拆成两半重试，不会整批丢弃；
# 连续 3 批失败会自动熔断本轮，不会在坏接口上空转。
